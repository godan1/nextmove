# Google Apps Script Web App URL (deployed from apps-script/Code.gs).
# The form posts to /api/quote, which forwards to this URL server-side.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional - shown nowhere publicly, used only for internal logging/labels.
NEXT_PUBLIC_SITE_NAME=NextMove

# Optional - Microsoft Clarity project ID for heatmaps + session recordings
# (clarity.microsoft.com, free). Leave unset to disable analytics entirely.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional - Google Analytics 4 Measurement ID for traffic/conversion
# analytics (analytics.google.com, free, starts with "G-"). Leave unset to
# disable. Complements Clarity: GA4 = traffic numbers, Clarity = heatmaps.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
