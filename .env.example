# Google Apps Script Web App URL (deployed from apps-script/Code.gs).
# The form posts to /api/quote, which forwards to this URL server-side.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Optional - shown nowhere publicly, used only for internal logging/labels.
NEXT_PUBLIC_SITE_NAME=NextMove
